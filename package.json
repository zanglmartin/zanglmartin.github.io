{
  "name": "martin-zangl-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:pages": "GITHUB_PAGES=true react-router build && node scripts/prepare-pages.mjs",
    "preview": "node scripts/serve-pages.mjs",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "test:static": "node --import tsx --test tests/portfolio.test.mjs tests/content-validation.test.ts",
    "test:e2e": "playwright test",
    "test:live": "node scripts/smoke-live.mjs",
    "test": "npm run build:pages && npm run test:static && npm run test:e2e"
  },
  "dependencies": {
    "@react-router/node": "8.3.0",
    "isbot": "^5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "8.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "pdfjs-dist": "^6.2.108",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "^8.2.2"
  }
}
